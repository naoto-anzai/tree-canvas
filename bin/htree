#!/usr/bin/env python3
"""htree: tree-canvas Mod の木構造文書を、エージェントが編集する CLI。
文書は ~/.herdr/trees/<doc>.json。Mod は保存を検知して即描画する。

  htree where                            いま使う置き場所を表示
  htree init                             このプロジェクト(git ルート)に .herdr/trees/ を作る
  htree ls
  htree show <doc>                       ASCII で表示(id 付き)
  htree put <doc> [--title T] [-f FILE]  インデント付き箇条書きを stdin/FILE から丸ごと作成
  htree add <doc> <parent|root> <label> [--note N] [--status S] [--id ID] [--index I]
  htree edit <doc> <id> [--label L] [--note N] [--status S] [--collapsed true|false]
  htree rm <doc> <id>
  htree mv <doc> <id> <new-parent> [--index I]
  htree dir <doc> LR|TD                  レイアウト方向(mermaid の flowchart LR / TD)
  htree json <doc>                       生の JSON を出力
  htree open <doc>                       herdr の右側に Mod ペインとして表示
  htree rmdoc <doc>

置き場所: HTREE_DIR > 上のフォルダにある .herdr/trees/ > ~/.herdr/trees/ 。
  -g (全コマンドの前に付ける) で共通の ~/.herdr/trees/ を強制する。

put の書式(2 空白でインデント):
  - [done] ラベル :: 注記
  - [doing] 子ノード
status: todo / doing / done / blocked / idle (省略可)
"""
import argparse, json, os, re, subprocess, sys, tempfile

GLOBAL_DIR = os.path.expanduser("~/.herdr/trees")
DIR = GLOBAL_DIR  # main() が決め直す

def project_root(start):
    """start から上へ、.herdr/trees を持つ最初のフォルダ。なければ None。"""
    d = os.path.abspath(start)
    while True:
        if os.path.isdir(os.path.join(d, ".herdr", "trees")):
            return d
        if os.path.dirname(d) == d:
            return None
        d = os.path.dirname(d)

def git_root(start):
    r = subprocess.run(["git", "-C", start, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else os.path.abspath(start)

def resolve_dir(use_global):
    """置き場所の優先順: HTREE_DIR > (-g なら共通) > 上方の .herdr/trees > 共通。"""
    env = os.environ.get("HTREE_DIR")
    if env:
        return os.path.expanduser(env)
    if not use_global:
        root = project_root(os.getcwd())
        if root:
            return os.path.join(root, ".herdr", "trees")
    return GLOBAL_DIR
STATUSES = {"todo", "doing", "done", "blocked", "idle"}

def path(doc):
    if not re.fullmatch(r"[\w.\-]+", doc):
        sys.exit(f"文書名が不正です: {doc}")
    return os.path.join(DIR, doc + ".json")

def load(doc):
    try:
        return json.load(open(path(doc)))
    except FileNotFoundError:
        sys.exit(f"文書がありません: {doc} (htree put {doc} で作成)")

def save(doc, data):
    os.makedirs(DIR, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=DIR, suffix=".tmp")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    os.replace(tmp, path(doc))  # 原子的に置換 (Mod の監視は *.json のみ見る)

def walk(node, parent=None):
    yield node, parent
    for c in node.get("children", []):
        yield from walk(c, node)

def ids(data):
    return {n["id"] for n, _ in walk(data["root"])}

def new_id(data):
    used, i = ids(data), 1
    while f"n{i}" in used:
        i += 1
    return f"n{i}"

def find(data, id_):
    if id_ == "root":
        return data["root"], None
    for n, p in walk(data["root"]):
        if n["id"] == id_:
            return n, p
    sys.exit(f"ノードがありません: {id_}")

def check_status(s):
    if s and s not in STATUSES:
        sys.exit(f"status は {sorted(STATUSES)} のいずれか: {s}")

LINE = re.compile(r"^(?P<ind>\s*)[-*]\s+(?:\[(?P<st>\w+)\]\s+)?(?P<label>.*?)(?:\s+::\s+(?P<note>.*))?$")

def parse_outline(text):
    stack, roots, n = [], [], 0
    for raw in text.splitlines():
        if not raw.strip():
            continue
        m = LINE.match(raw.replace("\t", "  "))
        if not m:
            sys.exit(f"行を解釈できません: {raw!r}")
        n += 1
        node = {"id": f"n{n}", "label": m["label"].strip()}
        if m["st"]:
            check_status(m["st"]); node["status"] = m["st"]
        if m["note"]:
            node["note"] = m["note"].strip()
        depth = len(m["ind"]) // 2
        while len(stack) > depth:
            stack.pop()
        if stack:
            stack[-1].setdefault("children", []).append(node)
        else:
            roots.append(node)
        stack.append(node)
    if not roots:
        sys.exit("入力が空です")
    if len(roots) == 1:
        return roots[0]
    return {"id": "n0", "label": "root", "children": roots}

def render(node, prefix="", last=True, top=True):
    st = f"[{node['status']}] " if node.get("status") else ""
    note = f"  :: {node['note']}" if node.get("note") else ""
    line = f"{st}{node.get('label', '')}{note}  ({node['id']})"
    out = [line if top else prefix + ("└─ " if last else "├─ ") + line]
    kids = node.get("children", [])
    for i, c in enumerate(kids):
        out += render(c, "" if top else prefix + ("   " if last else "│  "), i == len(kids) - 1, False)
    return out

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-g", "--global", dest="glob", action="store_true", help="共通の ~/.herdr/trees を使う")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("ls"); sub.add_parser("where"); sub.add_parser("init")
    for c in ("show", "json", "open", "rmdoc"):
        sub.add_parser(c).add_argument("doc")
    p = sub.add_parser("put"); p.add_argument("doc"); p.add_argument("--title"); p.add_argument("-f", "--file")
    p = sub.add_parser("add"); p.add_argument("doc"); p.add_argument("parent"); p.add_argument("label")
    p.add_argument("--note"); p.add_argument("--status"); p.add_argument("--id"); p.add_argument("--index", type=int)
    p = sub.add_parser("edit"); p.add_argument("doc"); p.add_argument("id")
    p.add_argument("--label"); p.add_argument("--note"); p.add_argument("--status"); p.add_argument("--collapsed"); p.add_argument("--shape")
    p = sub.add_parser("dir"); p.add_argument("doc"); p.add_argument("direction", choices=["LR", "TD"])
    p = sub.add_parser("rm"); p.add_argument("doc"); p.add_argument("id")
    p = sub.add_parser("mv"); p.add_argument("doc"); p.add_argument("id"); p.add_argument("parent"); p.add_argument("--index", type=int)
    a = ap.parse_args()
    global DIR
    if a.cmd == "init":
        DIR = os.path.join(git_root(os.getcwd()), ".herdr", "trees")
        os.makedirs(DIR, exist_ok=True); print(DIR); return
    DIR = resolve_dir(a.glob)
    if a.cmd == "where":
        print(DIR); return

    if a.cmd == "ls":
        for f in sorted(os.listdir(DIR)) if os.path.isdir(DIR) else []:
            if f.endswith(".json"):
                print(f[:-5])
    elif a.cmd == "show":
        d = load(a.doc)
        if d.get("title"): print(d["title"])
        print("\n".join(render(d["root"])))
    elif a.cmd == "json":
        print(json.dumps(load(a.doc), ensure_ascii=False, indent=2))
    elif a.cmd == "put":
        text = open(a.file).read() if a.file else sys.stdin.read()
        root = parse_outline(text)
        save(a.doc, {"title": a.title or a.doc, "root": root})
        print(f"saved {a.doc} ({sum(1 for _ in walk(root))} nodes)")
    elif a.cmd == "add":
        d = load(a.doc); parent, _ = find(d, a.parent); check_status(a.status)
        nid = a.id or new_id(d)
        if nid in ids(d): sys.exit(f"id が重複: {nid}")
        node = {"id": nid, "label": a.label}
        if a.note: node["note"] = a.note
        if a.status: node["status"] = a.status
        kids = parent.setdefault("children", [])
        kids.insert(len(kids) if a.index is None else a.index, node)
        save(a.doc, d); print(nid)
    elif a.cmd == "edit":
        d = load(a.doc); n, _ = find(d, a.id); check_status(a.status)
        for k in ("label", "note", "status"):
            v = getattr(a, k)
            if v is not None:
                if v == "" and k != "label": n.pop(k, None)
                else: n[k] = v
        if a.shape is not None:
            if a.shape not in ("", "rect", "round", "stadium"): sys.exit("shape は rect / round / stadium")
            if a.shape: n["shape"] = a.shape
            else: n.pop("shape", None)
        if a.collapsed is not None: n["collapsed"] = a.collapsed.lower() == "true"
        save(a.doc, d); print("ok")
    elif a.cmd == "dir":
        d = load(a.doc); d["direction"] = a.direction; save(a.doc, d); print("ok")
    elif a.cmd == "rm":
        d = load(a.doc); n, p = find(d, a.id)
        if p is None: sys.exit("root は消せません (htree rmdoc)")
        p["children"].remove(n)
        if not p["children"]: del p["children"]
        save(a.doc, d); print("ok")
    elif a.cmd == "mv":
        d = load(a.doc); n, p = find(d, a.id); dest, _ = find(d, a.parent)
        if p is None: sys.exit("root は動かせません")
        if any(x is dest for x, _ in walk(n)): sys.exit("自分の子孫には移せません")
        p["children"].remove(n)
        if not p["children"]: del p["children"]
        kids = dest.setdefault("children", [])
        kids.insert(len(kids) if a.index is None else a.index, n)
        save(a.doc, d); print("ok")
    elif a.cmd == "rmdoc":
        os.remove(path(a.doc)); print("ok")
    elif a.cmd == "open":
        load(a.doc)
        props = {"doc": a.doc}
        if DIR != GLOBAL_DIR and DIR.endswith(os.path.join(".herdr", "trees")):
            props["folder"] = os.path.dirname(os.path.dirname(DIR))
        elif DIR != GLOBAL_DIR:
            props["file"] = path(a.doc)
        r = subprocess.run(["herdr-app", "do", "pane.split", "--direction", "right", "--mod", "tree-canvas",
                            "--props", json.dumps(props)], capture_output=True, text=True)
        print(r.stdout.strip() or r.stderr.strip()); sys.exit(r.returncode)

main()
